// Publicación en Cloudflare (Workers con assets estáticos, sin script): `npm run deploy` construye y sube `dist/`.
// Todo el juego se construye por código en el navegador: `dist/` solo lleva el código y las tipografías.
// El nombre del Worker (`name`) es el de la URL y el que usa la conexión con GitHub en Cloudflare: no lo cambies
// sin crear otro Worker.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bucle-de-tiempo",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
  },
}
